{
    "name": "a",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm gen:theme && vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "pnpm gen:theme && vite build",
        "type-check": "vue-tsc --build",
        "lint": "run-s \"lint:*\"",
        "lint:oxlint": "oxlint . --fix",
        "lint:eslint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "gen:theme": "node scripts/generate-theme.mjs"
    },
    "dependencies": {
        "@lucide/vue": "^1.52.0",
        "@vueuse/core": "^15.0.0",
        "pinia": "^4.0.3",
        "reka-ui": "^2.10.5",
        "uuid": "^14.0.2",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "vue3-moveable": "^0.28.0"
    },
    "devDependencies": {
        "@ant-design/colors": "8.0.1",
        "@iconify/vue": "^5.0.3",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.19.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "~1.82.0",
        "eslint-plugin-vue": "~10.11.0",
        "jiti": "^2.7.0",
        "npm-run-all2": "^9.0.3",
        "oxlint": "~1.82.0",
        "prettier": "3.9.6",
        "sass": "^1.105.1",
        "typescript": "~6.0.0",
        "vite": "^8.2.2",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
